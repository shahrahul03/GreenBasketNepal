# =============================================================================
# Green Basket Nepal - Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values before running.
# For production builds, also create .env.production with production values.
# NEVER commit actual .env files to version control.
# =============================================================================

# API Base URL
# Development: http://localhost:8080/api/v1
# Production (same-origin via Nginx proxy): /api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# App
VITE_APP_NAME=Green Basket Nepal
VITE_APP_URL=http://localhost:5173

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
