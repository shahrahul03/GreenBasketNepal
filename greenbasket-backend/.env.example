# =============================================================================
# Green Basket Nepal - Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values before running.
# NEVER commit the .env file to version control.
# =============================================================================

# ---- Database ----
# For local MySQL: jdbc:mysql://localhost:3306/green_basket_nepal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kathmandu
# For Railway MySQL: jdbc:mysql://<host>:<port>/<database>?useSSL=true&requireSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/green_basket_nepal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kathmandu
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# ---- JWT ----
# Generate with: openssl rand -base64 32 (or any 64+ char string)
JWT_ACCESS_SECRET=your-access-token-secret-at-least-64-characters-long
JWT_REFRESH_SECRET=your-refresh-token-secret-at-least-64-characters-long
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ---- Email (SMTP) ----
# Gmail example: smtp.gmail.com, port 587, with app password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM=noreply@greenbasketnepal.com
ADMIN_EMAIL=admin@greenbasketnepal.com

# ---- App ----
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads

# ---- HikariCP (Connection Pool) ----
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5

# ---- Server ----
PORT=8080
API_SERVER_URL=http://localhost:8080
